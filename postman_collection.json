      "name": "01 Create order (valid)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{customer_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/orders/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "orders",
            ""
          ],
          "query": []
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    {\n      \"product_id\": 1,\n      \"quantity\": 2\n    },\n    {\n      \"product_id\": 3,\n      \"quantity\": 1\n    }\n  ],\n  \"shipping_address_id\": 5,\n  \"notes\": \"Please deliver during evening hours\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j = pm.response.json();",
              "if (j.id) { pm.collectionVariables.set('order_id', j.id); pm.collectionVariables.set('order_number', j.order_number); }"
            ]
          }
        }
      ]
