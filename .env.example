# ---- Database (used when running locally, outside Docker) ----
DATABASE_URL=mysql+pymysql://order_user:order_pass@localhost:3309/shopease_order_db

# ---- JWT: must be the SAME secret/algorithm the Auth Service signs with ----
JWT_SECRET_KEY=change-this-to-the-auth-service-secret
JWT_ALGORITHM=HS256
JWT_USER_ID_CLAIM=sub
JWT_ROLE_CLAIM=role
ADMIN_ROLES=admin,administrator
SERVICE_ACCOUNT_SUB=order-service

# ---- Other services (from the host machine). Inside Docker the compose file
#      rewrites these to host.docker.internal ----
USER_SERVICE_URL=http://localhost:8002
PRODUCT_SERVICE_URL=http://localhost:8003
HTTP_TIMEOUT_SECONDS=5

# ---- Endpoint paths on the other services (adjust to match YOUR services) ----
USER_ADDRESS_PATH=/api/addresses/{address_id}
USER_PROFILE_PATH=/api/users/me
PRODUCT_DETAIL_PATH=/api/products/{product_id}
STOCK_OUT_PATH=/api/inventory/{product_id}/stock-out
STOCK_IN_PATH=/api/inventory/{product_id}/stock-in

# ---- Pricing rules ----
TAX_RATE=0.18
SHIPPING_CHARGE=50.00
FREE_SHIPPING_THRESHOLD=1000.00
DISCOUNT_MIN_SUBTOTAL=5000.00
DISCOUNT_PERCENT=10
